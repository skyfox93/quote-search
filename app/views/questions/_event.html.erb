<%# One step of an agent run (SearchAgent::Event). Used live on /ask and on the landing page. %>
<% preview_rows = local_assigns.fetch(:preview_rows, 5) %>
<% case event.kind %>
<% when :sql %>
  <% result = event.result %>
  <li class="agent-step agent-step--sql<%= " agent-step--failed" unless result.ok? %>">
    <div class="agent-step__head">
      <span class="agent-step__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="14" height="14"><path d="M12 3c4.97 0 9 1.34 9 3v12c0 1.66-4.03 3-9 3s-9-1.34-9-3V6c0-1.66 4.03-3 9-3Zm7 11.6c-1.65.9-4.2 1.4-7 1.4s-5.35-.5-7-1.4V18c.2.45 2.73 1.5 7 1.5s6.8-1.05 7-1.5v-3.4Zm0-6c-1.65.9-4.2 1.4-7 1.4S6.65 9.5 5 8.6V12c.2.45 2.73 1.5 7 1.5s6.8-1.05 7-1.5V8.6ZM12 4.5C7.73 4.5 5.2 5.55 5 6c.2.45 2.73 1.5 7 1.5s6.8-1.05 7-1.5c-.2-.45-2.73-1.5-7-1.5Z" fill="currentColor"/></svg>
      </span>
      <span class="agent-step__title"><%= event.text.presence || "Ran a query" %></span>
      <span class="agent-step__stats">
        <% if result.ok? %>
          <%= pluralize(result.row_count, "row") %><%= "+" if result.truncated %> · <%= result.ms %>ms
        <% else %>
          error
        <% end %>
      </span>
    </div>
    <pre class="sql"><code><%= result.sql %></code></pre>
    <% if !result.ok? %>
      <p class="agent-step__error"><%= result.error %></p>
    <% elsif result.rows.any? %>
      <div class="table-wrap">
        <table class="mini-table">
          <thead><tr><% result.columns.each do |column| %><th><%= column %></th><% end %></tr></thead>
          <tbody>
            <% result.rows.first(preview_rows).each do |row| %>
              <tr><% row.each do |value| %><td><%= value.is_a?(Numeric) ? number_with_delimiter(value) : value.to_s.truncate(80) %></td><% end %></tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if result.row_count > preview_rows %>
        <p class="agent-step__more"><%= pluralize(result.row_count - preview_rows, "more row") %> sent to the model</p>
      <% end %>
    <% else %>
      <p class="agent-step__more">No rows.</p>
    <% end %>
  </li>
<% when :answer %>
  <li class="agent-step agent-step--answer">
    <div class="card ai-answer">
      <header class="ai-answer__header">
        <svg class="ai-answer__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 2l1.9 5.6L19.5 9.5l-5.6 1.9L12 17l-1.9-5.6L4.5 9.5l5.6-1.9L12 2Zm7 12 .95 2.55L22.5 17.5l-2.55.95L19 21l-.95-2.55L15.5 17.5l2.55-.95L19 14Z" fill="currentColor"/></svg>
        <h2 class="ai-answer__title">Answer</h2>
      </header>
      <div class="ai-answer__body"><%= simple_format(h(event.text), {}, sanitize: false) %></div>
      <p class="ai-answer__footnote">Written by AI from the query results above. It can make mistakes.</p>
    </div>
  </li>
<% else %>
  <li class="agent-step agent-step--error"><div class="notice notice--error" role="alert"><%= event.text %></div></li>
<% end %>
