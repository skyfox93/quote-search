<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? safe_join([yield(:title), " · Trek Script Search"]) : "Trek Script Search" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 2 4.5 21l7.5-4.2 7.5 4.2L12 2Z" fill="currentColor"/></svg>
          </span>
          <span class="brand__name"> Searchable Star Trek </span>
        <% end %>
        <nav class="tabs" aria-label="Search mode">
          <%= link_to root_path(anchor: "level-1"), class: ["tabs__tab", ("is-active" if controller_name == "dialogues")], title: "Level 1: keyword search" do %><span class="tabs__num">1</span><span class="tabs__long">Find a quote</span><span class="tabs__short">Quote</span><% end %>
          <%= link_to root_path(anchor: "level-2"), class: ["tabs__tab", ("is-active" if controller_name == "episode_texts")], title: "Level 2: RAG with AI summaries" do %><span class="tabs__num">2</span><span class="tabs__long">Describe a scene</span><span class="tabs__short">Scene</span><% end %>
          <%= link_to root_path(anchor: "level-3"), class: ["tabs__tab", ("is-active" if controller_name == "questions")], title: "Level 3: AI agent with SQL" do %><span class="tabs__num">3</span><span class="tabs__long">Ask a question</span><span class="tabs__short">Ask</span><% end %>
        </nav>
      </div>
    </header>

    <main class="container main">
      <% flash.each do |type, message| %>
        <div class="flash flash--<%= type %>" role="status"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        A fan-made search for Star Trek transcripts, for educational and entertainment use.
        Star Trek and related marks are trademarks of CBS Studios Inc.
      </div>
    </footer>
  </body>
</html>
