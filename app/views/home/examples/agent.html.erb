<turbo-frame id="example-agent" target="_top">
  <div class="card example">
    <div class="example__query"><span class="example__label">Example</span> <span>“<%= @query %>”</span></div>

    <% if @error %>
      <p class="example__note"><%= @error %></p>
    <% else %>
      <% queries = @events.count { _1.kind == :sql } %>
      <p class="example__note">The agent ran <%= pluralize(queries, "query") %> before answering:</p>
      <ol class="agent-steps agent-steps--compact">
        <% @events.each do |event| %>
          <%= render "questions/event", event: event, preview_rows: 3 %>
        <% end %>
      </ol>
      <%= link_to "Ask your own question", ask_path, class: "link-arrow example__more" %>
    <% end %>
  </div>
</turbo-frame>
