<turbo-frame id="example-keyword" target="_top">
  <div class="card example">
    <div class="example__query"><span class="example__label">Example</span> <span>“<%= @query %>”</span></div>

    <div class="compare">
      <div class="compare__item">
        <span class="compare__num"><%= number_with_delimiter(@keyword[:exact_count]) %></span>
        <span class="compare__label">lines with the exact word</span>
      </div>
      <div class="compare__arrow" aria-hidden="true">→</div>
      <div class="compare__item compare__item--win">
        <span class="compare__num"><%= number_with_delimiter(@keyword[:dictionary_count]) %></span>
        <span class="compare__label">with the dictionary (stem “<%= @keyword[:stem] %>”)</span>
      </div>
    </div>

    <% forms = matched_forms(@keyword[:rows].map { _1[:headline] }) %>
    <% if forms.any? %>
      <p class="example__note">Matched forms include <%= safe_join(forms.map { content_tag(:mark, _1) }, ", ") %>.</p>
    <% end %>

    <ol class="quote-list quote-list--compact">
      <% @keyword[:rows].each do |row| %>
        <li class="quote-item">
          <%= link_to dialogue_path(row[:id], anchor: "match"), class: "quote-item__link" do %>
            <blockquote class="quote-item__line"><%= headline_marks(row[:headline]) %></blockquote>
            <div class="quote-item__meta">
              <span class="speaker"><%= row[:character] %></span>
              <span class="dot" aria-hidden="true">·</span>
              <span class="badge badge--small"><%= row[:series] %></span>
              <span><%= @keyword[:titles][[row[:series], row[:episode]]] || row[:episode] %></span>
            </div>
          <% end %>
        </li>
      <% end %>
    </ol>

    <%= link_to "See all #{number_with_delimiter(@keyword[:dictionary_count])} results", dialogues_path(query: @query, dictionary: 1), class: "link-arrow example__more" %>
  </div>
</turbo-frame>
