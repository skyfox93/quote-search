<turbo-frame id="example-rag" target="_top">
  <div class="card example">
    <div class="example__query"><span class="example__label">Example</span> <span>“<%= @query %>”</span></div>

    <% if @error %>
      <p class="example__note"><%= @error %></p>
    <% elsif @search.hits.empty? %>
      <p class="example__note">No scenes found.</p>
    <% else %>
      <% if @answer.present? %>
        <div class="ai-answer ai-answer--inline">
          <header class="ai-answer__header">
            <svg class="ai-answer__icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 2l1.9 5.6L19.5 9.5l-5.6 1.9L12 17l-1.9-5.6L4.5 9.5l5.6-1.9L12 2Zm7 12 .95 2.55L22.5 17.5l-2.55.95L19 21l-.95-2.55L15.5 17.5l2.55-.95L19 14Z" fill="currentColor"/></svg>
            <h3 class="ai-answer__title">AI answer</h3>
          </header>
          <p class="ai-answer__body"><%= cited_answer(@answer, max: 3, prefix: "rag-hit") %></p>
        </div>
      <% end %>

      <ol class="mini-results">
        <% @search.hits.first(3).each do |hit| %>
          <% scene = hit.scenes.first %>
          <% lines = ScriptText.lines(scene.content) %>
          <% lines = lines.drop(1) if scene.position.positive? && lines.size > 1 %>
          <% shown = ScriptText.excerpt(lines, ScriptText.terms(@search.plan.keywords, @query), size: 3) %>
          <li id="rag-hit-<%= hit.rank %>" class="mini-result">
            <div class="mini-result__head">
              <span class="mini-result__rank"><%= hit.rank %></span>
              <span class="badge badge--small"><%= hit.episode.series %></span>
              <% if hit.episode.short_number %><span class="result__number"><%= hit.episode.short_number %></span><% end %>
              <%= link_to hit.episode.display_title,
                          episode_text_path(hit.episode, chunk: scene.id, line: shown.first.index,
                                            lines: shown.last.index - shown.first.index + 1, anchor: "match"),
                          class: "mini-result__title" %>
            </div>
            <div class="script script--excerpt script--small"><%= script_lines(shown, terms: ScriptText.terms(@search.plan.keywords, @query)) %></div>
          </li>
        <% end %>
      </ol>

      <%= link_to "See all #{@search.hits.size} results", episode_texts_path(query: @query), class: "link-arrow example__more" %>
    <% end %>
  </div>
</turbo-frame>
