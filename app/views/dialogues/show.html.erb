<% content_for :title, "#{@dialogue.character}: #{@dialogue.line.truncate(60)}" %>

<%= render "application/episode_header", episode: @episode, back: true %>

<figure class="card featured-quote">
  <blockquote class="featured-quote__line">“<%= @dialogue.line %>”</blockquote>
  <figcaption class="featured-quote__by">
    <span class="speaker"><%= @dialogue.character %></span>
    <% if @highlight %>· <%= link_to "See it in the script", "#match", class: "link-arrow" %><% end %>
  </figcaption>
</figure>

<article class="card script script--full" aria-label="Transcript">
  <%= script_lines(@lines, highlight: @highlight) %>
</article>
