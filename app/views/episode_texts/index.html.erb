<% content_for :title, @query.presence || "Describe a scene" %>

<section class="search-hero<%= " search-hero--compact" if @query.present? %>">
  <% if @query.blank? %>
    <h1 class="search-hero__title">Find any Star Trek scene by describing it</h1>
    <p class="search-hero__lede">Search by what happens, not the exact words. AI reads your description, searches the scripts, and explains what it found.</p>
  <% end %>

  <%= form_with url: episode_texts_path, method: :get, class: "search-box", role: "search", data: { turbo_frame: "_top" } do %>
    <label for="query" class="visually-hidden">Describe a scene</label>
    <svg class="search-box__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M10.5 3a7.5 7.5 0 0 1 5.96 12.06l4.24 4.23-1.42 1.42-4.23-4.24A7.5 7.5 0 1 1 10.5 3Zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Z" fill="currentColor"/></svg>
    <%= text_field_tag :query, @query, id: "query", class: "search-box__input", placeholder: "e.g. Geordi is brainwashed into becoming an assassin",
                        autocomplete: "off", autofocus: @query.blank?, maxlength: SearchQueryPlanner::MAX_QUERY_LENGTH %>
    <button type="submit" class="button button--primary search-box__button">Search</button>
  <% end %>

  <% if @query.blank? %>
    <div class="examples">
      <span class="examples__label">Try</span>
      <% ["Picard lives a whole life on another planet",
          "Data tries to learn how to be funny",
          "the ship keeps exploding and the crew relives the same day",
          "Q introduces the Borg"].each do |example| %>
        <%= link_to example, episode_texts_path(query: example), class: "chip" %>
      <% end %>
    </div>
  <% end %>
</section>

<% if @query.present? %>
  <turbo-frame id="search-results" src="<%= results_episode_texts_path(query: @query, all: params[:all].presence) %>" target="_top">
    <%= render "loading" %>
  </turbo-frame>
<% end %>
