<% episode = hit.episode %>
<% excerpts = hit.scenes.map do |scene|
     lines = ScriptText.lines(scene.content)
     shown = ScriptText.excerpt(lines, terms, size: 6)
     { lines: shown, link: episode_text_path(episode, chunk: scene.id, line: shown.first.index,
                                             lines: shown.last.index - shown.first.index + 1, anchor: "match") }
   end %>
<% best, *more = excerpts %>

<li class="card result" id="result-<%= hit.rank %>">
  <div class="result__rank" aria-hidden="true"><%= hit.rank %></div>
  <div class="result__body">
    <header class="result__header">
      <div class="result__meta">
        <span class="badge" title="<%= episode.series_name %>"><%= episode.series %></span>
        <% if episode.short_number %><span class="result__number"><%= episode.short_number %></span><% end %>
        <% if hit.rank == 1 %><span class="pill pill--accent">Best match</span><% end %>
        <span class="result__score" title="Average cosine similarity of the episode’s three closest scenes (1 = identical)">
          similarity <%= number_with_precision(hit.score, precision: 2) %>
        </span>
      </div>
      <h3 class="result__title"><%= link_to episode.display_title, best[:link] %></h3>
    </header>

    <% if episode.summary.present? %>
      <p class="result__summary"><%= episode.summary %></p>
    <% end %>

    <%= link_to best[:link], class: "excerpt", aria: { label: "Read the full scene in #{episode.display_title}" } do %>
      <div class="script script--excerpt"><%= script_lines(best[:lines], terms: terms) %></div>
    <% end %>

    <% if more.any? %>
      <details class="more-scenes">
        <summary><%= pluralize(more.size, "more matching scene") %></summary>
        <% more.each do |excerpt| %>
          <%= link_to excerpt[:link], class: "excerpt" do %>
            <div class="script script--excerpt"><%= script_lines(excerpt[:lines], terms: terms) %></div>
          <% end %>
        <% end %>
      </details>
    <% end %>

    <footer class="result__footer">
      <%= link_to "Read the full scene", best[:link], class: "link-arrow" %>
    </footer>
  </div>
</li>
