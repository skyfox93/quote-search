<% content_for :title, @episode.display_title %>

<%= render "application/episode_header", episode: @episode, back: true %>

<% if @scene %>
  <p class="jump-note">The matching scene from this episode.</p>
<% end %>

<article class="card script script--full" aria-label="<%= @scene ? "Scene" : "Transcript" %>">
  <%= script_lines(@lines, highlight: @highlight) %>
</article>
