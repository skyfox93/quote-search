<% content_for :title, @episode.display_title %>

<%= render "episode_texts/episode_header", episode: @episode, back: true %>

<% if @highlight %>
  <p class="jump-note">
    <%= link_to "Jump to the matching scene", "#match", class: "link-arrow" %>
  </p>
<% end %>

<article class="card script script--full" aria-label="Transcript">
  <%= script_lines(@lines, highlight: @highlight) %>
</article>
